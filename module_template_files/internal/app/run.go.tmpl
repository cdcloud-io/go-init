// ================ PUBLIC FUNCTION(s) =========================================
//
// Run(): the main program loop entrypoint
// listens for:
// - periodic ticks
// - context cancellation
func Run(ctx context.Context, w io.Writer, args []string) error {
	// optional: handle startup args
	if len(args) > 1 {
		fmt.Fprintf(w, "Arguments: %v\n", args[1:])
	}

	// setup app loop ticker
	ticker := time.NewTicker(10 * time.Second)
	defer ticker.Stop()

	// initial startup banner or message
	fmt.Fprintln(w, "{{server}} started. Press Ctrl+C to stop.")

	for {
		select {
		case <-ctx.Done():
			// program exit on timeout or SIGINT (Ctrl+C)
			// triggered by parent context cancellation (timeout or Ctrl+C)
			fmt.Fprintln(w, "\n⚙️ Context cancelled. Shutting down gracefully.")
			return nil

			// === ⚙️ MAIN PROGRAM LOOP ⚙️ ===
			// repeating program logic
		case t := <-ticker.C:
			// program loop begin
			// - poll file
			// - check db
			fmt.Fprintf(w, "⏰ Tick at %s\n", t.Format(time.RFC3339))
		}
	}

  return nil
}

